 // Calls a PPC function from host code with proper context setup
 
+// Use the bound context so nested callbacks see the active stack/TOC/PCR.
+// Restore isolated register state even when a native fixture throws.
+class ScopedCallbackContext {
+ public:
+  explicit ScopedCallbackContext(PPCContext& context) : context_(context), saved_(context) {
+    if (context.r1.u32 < 0x70 || (context.r1.u32 & 15)) {
+      throw std::invalid_argument("PPC callback requires an aligned stack frame");
+    }
+    context_.r1.u64 = context.r1.u32 - 0x70;
+  }
+  ~ScopedCallbackContext() {
+    auto fpscr = context_.fpscr;
+    context_ = saved_;
+    context_.fpscr = fpscr;
+  }
+  ScopedCallbackContext(const ScopedCallbackContext&) = delete;
+  ScopedCallbackContext& operator=(const ScopedCallbackContext&) = delete;
+ private:
+  PPCContext& context_;
+  PPCContext saved_;
+};
