+bool Memory::IsRangeAccessible(uint32_t address, uint64_t length, bool write) {
+  if (!address || !length || length > 0x100000000ull - address) return false;
+  uint64_t current = address, end = current + length;
+  while (current < end) {
+    auto* heap = LookupHeap(uint32_t(current));
+    if (!heap) return false;
+    HeapAllocationInfo info{};
+    if (!heap->QueryRegionInfo(uint32_t(current), &info) ||
+        !(info.state & kMemoryAllocationCommit) || !(info.protect & kMemoryProtectRead) ||
+        (write && !(info.protect & (kMemoryProtectWrite | kMemoryProtectWriteCombine))))
+      return false;
+    // Advance to a guest page boundary, never trusting host mapping permissions.
+    uint64_t page = heap->page_size();
+    uint64_t next = (current / page + 1) * page;
+    if (next <= current) return false;
+    current = std::min(next,end);
+  }
+  return true;
 }
 
