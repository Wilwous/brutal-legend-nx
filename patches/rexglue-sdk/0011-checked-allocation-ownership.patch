+// Checked allocation rounding only; unrelated generic math helpers are unchanged.
+// Zero-sized SDK reservations retain the existing minimum-one-page policy.
+constexpr bool CheckedAllocationRoundUp(uint32_t value, uint32_t multiple, uint32_t& out) {
+  if (!multiple) return false;
+  uint64_t rounded = value ? ((uint64_t(value)+multiple-1)/multiple)*multiple : multiple;
+  if (rounded > 0xffffffffull) return false;
+  out = uint32_t(rounded);
+  return true;
+}
