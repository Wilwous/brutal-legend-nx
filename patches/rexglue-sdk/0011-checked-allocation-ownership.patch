+void BaseHeap::SetAllocationOwner(uint32_t address, const void* owner) {
+  std::lock_guard<std::recursive_mutex> lock(heap_mutex_);
+  if (owner) allocation_owners_[address] = owner;
+  else allocation_owners_.erase(address);
+}
+
+bool BaseHeap::ReleaseOwned(uint32_t address, const void* owner) {
+  // Global-before-heap lock order matches allocation and physical heap paths.
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  std::lock_guard<std::recursive_mutex> lock(heap_mutex_);
+  auto it = allocation_owners_.find(address);
+  if (!owner || it == allocation_owners_.end() || it->second != owner) return false;
+  return Release(address);
 }
 
