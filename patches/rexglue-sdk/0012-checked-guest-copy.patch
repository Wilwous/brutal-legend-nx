+CheckedMemoryResult BaseHeap::CopyOwnedMemory(uint32_t allocation_base, const void* owner,
+    uint32_t address, void* host_buffer, uint64_t length, CheckedMemoryAccess access) {
+  // Trusted host buffers only, disjoint from guest mappings. Runtime teardown,
+  // Reset/Restore and MMIO registration must be quiescent for this API.
+  // 64 KiB bounds both the copy and exact (possibly masked) MMIO scan.
+  if (!address || !host_buffer || !length || length > 65536 ||
+      length > 0x100000000ull - address) return CheckedMemoryResult::invalid_range;
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  std::lock_guard<std::recursive_mutex> heap_lock(heap_mutex_);
+  const uint64_t end = uint64_t(address) + length;
+  // MMIO protects whole host pages. Conservatively reject even ordinary bytes
+  // sharing one with a masked MMIO address, so padding cannot cause a host fault.
+  const uint64_t host_page = memory_->system_page_size_;
+  const uint64_t scan_start = uint64_t(address) / host_page * host_page;
+  const uint64_t scan_end = ((end - 1) / host_page + 1) * host_page;
+  for (uint64_t byte = scan_start; byte < scan_end; ++byte) {
+    if (memory_->LookupVirtualMappedRange(uint32_t(byte))) return CheckedMemoryResult::mmio;
+  }
+  // Physical aliases, XEX and large-page heaps require different lifetime and
+  // instruction-fetch contracts. Do not infer them from host accessibility.
+  if (heap_type_ != HeapType::kGuestVirtual || page_size_ != 4096)
+    return CheckedMemoryResult::unsupported_heap;
+  if (address < heap_base_ || end > uint64_t(heap_base_) + heap_size_)
+    return CheckedMemoryResult::invalid_range;
+  auto it = allocation_owners_.find(allocation_base);
+  if (!owner || it == allocation_owners_.end() || it->second != owner)
+    return CheckedMemoryResult::ownership;
+  const uint32_t first = (address - heap_base_) >> page_size_shift_;
+  const uint32_t last = uint32_t((end - 1 - heap_base_) >> page_size_shift_);
+  for (uint32_t page = first; page <= last; ++page) {
+    const auto entry = page_table_[page];
+    if (!(entry.state & kMemoryAllocationReserve) ||
+        heap_base_ + (entry.base_address << page_size_shift_) != allocation_base)
+      return CheckedMemoryResult::ownership;
+    if (!(entry.state & kMemoryAllocationCommit)) return CheckedMemoryResult::uncommitted;
+    if (!(entry.current_protect & kMemoryProtectRead) ||
+        (access == CheckedMemoryAccess::write &&
+         !(entry.current_protect & (kMemoryProtectWrite | kMemoryProtectWriteCombine))))
+      return CheckedMemoryResult::protection;
+  }
+  if (access == CheckedMemoryAccess::fetch) return CheckedMemoryResult::unsupported_fetch;
+  if (access != CheckedMemoryAccess::read && access != CheckedMemoryAccess::write)
+    return CheckedMemoryResult::invalid_range;
+  // The heap lock pins metadata and backing through the copy against ordinary
+  // Alloc/AllocFixed/Release/Decommit/Protect. Never return a raw guest pointer.
+  auto* guest = TranslateRelative(address - heap_base_);
+  if (access == CheckedMemoryAccess::write) std::memcpy(guest, host_buffer, size_t(length));
+  else std::memcpy(host_buffer, guest, size_t(length));
+  return CheckedMemoryResult::ok;
+}
