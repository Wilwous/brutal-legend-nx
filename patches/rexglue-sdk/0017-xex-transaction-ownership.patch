+bool BaseHeap::AllocFixedOwned(uint32_t address, uint32_t size, const void* owner) {
+  uint32_t rounded = 0;
+  if (heap_type_ != HeapType::kGuestXex || !owner || address < heap_base_ || (address % page_size_) ||
+      !CheckedAllocationRoundUp(size, page_size_, rounded) ||
+      uint64_t(address) + rounded > uint64_t(heap_base_) + heap_size_) return false;
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  std::lock_guard<std::recursive_mutex> lock(heap_mutex_);
+  const uint32_t first = (address - heap_base_) >> page_size_shift_;
+  const uint32_t count = rounded >> page_size_shift_;
+  for (uint32_t i = 0; i < count; ++i) if (page_table_[first+i].state) return false;
+  // Both locks stay held through reserve, tagging, commit and rollback. Even a
+  // failed host permission reconciliation may have changed the page table, so
+  // unwind only the range proved empty above; never touch a foreign reservation.
+  try {
+    if (AllocFixed(address, rounded, page_size_, kMemoryAllocationReserve, 3)) {
+      SetAllocationOwner(address, owner);
+      if (AllocFixed(address, rounded, page_size_, kMemoryAllocationCommit, 3)) return true;
+    }
+  } catch (...) {
+    if (page_table_[first].state && !Release(address)) std::terminate();
+    throw;
+  }
+  if (page_table_[first].state && !Release(address)) std::terminate();
+  return false;
+}
