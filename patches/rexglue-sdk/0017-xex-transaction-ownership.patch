+XexModule::~XexModule() {
+  // A UserModule lease retains its legitimate object owner. Destruction with a
+  // live lease or stolen allocation is an ownership violation, never forced free.
+  if (!Unload()) std::terminate();
+}
+
+bool XexModule::AllocateImage(uint32_t address, uint32_t size) {
+  auto* heap = memory()->LookupHeap(address);
+  uint32_t rounded = 0;
+  if (!heap || heap->heap_type() != memory::HeapType::kGuestXex ||
+      !memory::CheckedAllocationRoundUp(size, heap->page_size(), rounded) ||
+      uint64_t(address) + rounded > 0x100000000ull) return false;
+  if (!heap->AllocFixedOwned(address, rounded, this)) return false;
+  try { owned_images_.push_back({address, rounded}); }
+  catch (...) { if (!heap->ReleaseOwned(address, this)) std::terminate(); throw; }
+  return true;
+}
+
+bool XexModule::ReleaseImages() {
+  while (!owned_images_.empty()) {
+    auto region = owned_images_.back();
+    if (!memory()->LookupHeap(region.address)->ReleaseOwned(region.address, this)) return false;
+    owned_images_.pop_back();
+  }
+  return true;
+}
+
+bool XexModule::ImageContains(uint32_t address, uint64_t size) const {
+  if (!size) return false;
+  for (auto region : owned_images_)
+    if (address >= region.address && size <= uint64_t(region.size) &&
+        uint64_t(address) - region.address <= uint64_t(region.size) - size) return true;
+  return false;
+}
+
+bool XexModule::AcquireImageLease() {
+  std::lock_guard lock(lifecycle_mutex_);
+  if (!loaded_ || !finished_load_ || close_requested_) return false;
+  ++image_leases_;
+  return true;
+}
+
+void XexModule::ReleaseImageLease() {
+  std::lock_guard lock(lifecycle_mutex_);
+  assert_true(image_leases_ != 0);
+  --image_leases_;
+}
 
