+bool XexModule::ReadTlsInfo(xex2_opt_tls_info* out) const {
+  std::lock_guard lock(lifecycle_mutex_);
+  if (!out) return false;
+  *out = {};
+  if (!loaded_) return false;
+  xex2_opt_tls_info* header = nullptr;
+  if (!GetOptHeader(XEX_HEADER_TLS_INFO, &header)) return true;
+  const uint64_t slots = header->slot_count, size = header->data_size;
+  const uint64_t raw_size = header->raw_data_size;
+  const uint32_t raw = header->raw_data_address;
+  // The process bitmap implements 256 slots. Larger layouts are unverified.
+  // A 1 MiB bound is an explicit host admission policy, not an Xbox limit.
+  if (!slots || slots > 256 || (slots & 3) || (size & 3) || (raw & 3) ||
+      raw_size > size || size + slots * 4 > 1024 * 1024 ||
+      (raw_size ? (!raw || !ImageContains(raw, raw_size)) : raw != 0)) return false;
+  *out = *header;
+  return true;
+}
