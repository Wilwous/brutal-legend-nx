+X_STATUS XThread::CreateWithModule(object_ref<UserModule> module) {
+  if (create_attempted_) return X_STATUS_UNSUCCESSFUL;
+  create_attempted_ = true;
+  xex2_opt_tls_info tls_info{};
+  if (module) {
+    auto lease = module->AcquireImageLease();
+    if (!lease || !module->xex_module()->ReadTlsInfo(&tls_info)) return X_STATUS_INVALID_PARAMETER;
+    tls_image_lease_.emplace(std::move(*lease));
+  }
+  X_STATUS status;
+  try { status = CreateInternal(tls_info); }
+  catch (const std::bad_alloc&) { status = X_STATUS_NO_MEMORY; }
+  if (status != X_STATUS_SUCCESS) {
+    // Late host exceptions after a native thread exists require a dedicated
+    // cancellation protocol. Never free a live/suspended callback context.
+    if (thread_) std::terminate();
+    thread_state_.reset();
+    memory()->SystemHeapFree(scratch_address_); scratch_address_ = 0;
+    memory()->SystemHeapFree(tls_static_address_); tls_static_address_ = 0;
+    tls_dynamic_address_ = tls_total_size_ = 0;
+    memory()->SystemHeapFree(pcr_address_); pcr_address_ = 0;
+    FreeStack();
+    tls_image_lease_.reset();
+  }
+  return status;
+}
