+memory::CheckedMemoryResult XexModule::CopyImageMemory(uint32_t address, void* host_buffer,
+    uint64_t length, memory::CheckedMemoryAccess access) {
+  std::lock_guard lock(lifecycle_mutex_);
+  if (!loaded_ || !finished_load_ || !image_leases_ || !length || length>65536 ||
+      length>0x100000000ull-address) return memory::CheckedMemoryResult::invalid_range;
+  // Require one declared PE section, including its byte bounds and flags.
+  unsigned section_matches=0;
+  for (const auto& section:pe_sections_) {
+    const uint64_t low=uint64_t(section.address);
+    if (address>=low && uint64_t(address)+length<=low+section.size) {
+      const uint32_t flags=section.flags;
+      if (!(flags&0x40000000u) || (access==memory::CheckedMemoryAccess::write && !(flags&0x80000000u)))
+        return memory::CheckedMemoryResult::protection;
+      ++section_matches;
+    }
+  }
+  if (section_matches!=1) return memory::CheckedMemoryResult::invalid_range;
+  for (auto image:owned_images_) if (address>=image.address &&
+      uint64_t(address)+length<=uint64_t(image.address)+image.size)
+    return memory()->LookupHeap(image.address)->CopyOwnedImageMemory(image.address,this,address,host_buffer,length,access);
+  return memory::CheckedMemoryResult::ownership;
+}
